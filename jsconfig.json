{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [],
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "pages/**/*.js", "pages/**/*.jsx", "src/components/**/*.js", "src/page-content/**/*.jsx", "src/Layout.jsx"],
  "exclude": ["node_modules", ".next", "dist", "src/components/ui", "src/api", "src/lib"]
}

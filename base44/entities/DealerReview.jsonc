{
  "name": "DealerReview",
  "type": "object",
  "properties": {
    "dealerId": {
      "type": "string"
    },
    "dealerName": {
      "type": "string"
    },
    "buyerId": {
      "type": "string"
    },
    "buyerName": {
      "type": "string"
    },
    "orderId": {
      "type": "string"
    },
    "orderReference": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "title": {
      "type": "string"
    },
    "reviewText": {
      "type": "string"
    },
    "isVerifiedPurchase": {
      "type": "boolean",
      "default": true
    },
    "dealerResponse": {
      "type": "string"
    },
    "dealerRespondedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "dealerId",
    "buyerId",
    "rating",
    "reviewText"
  ],
  "rls": {
    "read": true,
    "create": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.dealerId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}
{
  "name": "Collections",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string"
    },
    "collectionName": {
      "type": "string"
    },
    "collectionName_en": {
      "type": "string"
    },
    "collectionName_de": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "description_en": {
      "type": "string"
    },
    "description_de": {
      "type": "string"
    },
    "heroImage": {
      "type": "string"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoTitle_en": {
      "type": "string"
    },
    "seoTitle_de": {
      "type": "string"
    },
    "seoDescription": {
      "type": "string"
    },
    "seoDescription_en": {
      "type": "string"
    },
    "seoDescription_de": {
      "type": "string"
    },
    "seoKeywords": {
      "type": "string"
    },
    "seoKeywords_en": {
      "type": "string"
    },
    "seoKeywords_de": {
      "type": "string"
    }
  },
  "required": [
    "brand",
    "collectionName",
    "slug"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}
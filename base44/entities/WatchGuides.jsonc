{
  "name": "WatchGuides",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "title_en": {
      "type": "string"
    },
    "title_de": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Buying Guide",
        "Brand Guide",
        "Investment Guide",
        "Authentication Guide",
        "Care Guide",
        "Comparison"
      ]
    },
    "featuredImage": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "content_en": {
      "type": "string"
    },
    "content_de": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "excerpt_en": {
      "type": "string"
    },
    "excerpt_de": {
      "type": "string"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoTitle_en": {
      "type": "string"
    },
    "seoTitle_de": {
      "type": "string"
    },
    "seoDescription": {
      "type": "string"
    },
    "seoDescription_en": {
      "type": "string"
    },
    "seoDescription_de": {
      "type": "string"
    },
    "seoKeywords": {
      "type": "string"
    },
    "seoKeywords_en": {
      "type": "string"
    },
    "seoKeywords_de": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "de",
        "en"
      ],
      "default": "de"
    },
    "relatedBrands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedCollections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
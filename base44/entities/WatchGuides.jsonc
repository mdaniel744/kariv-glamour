{
  "name": "WatchGuides",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Buying Guide",
        "Brand Guide",
        "Investment Guide",
        "Authentication Guide",
        "Care Guide",
        "Comparison"
      ]
    },
    "featuredImage": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "string"
    },
    "seoKeywords": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "de",
        "en"
      ],
      "default": "de"
    },
    "relatedBrands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedCollections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "slug"
  ]
}
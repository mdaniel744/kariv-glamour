{
  "name": "FAQ",
  "type": "object",
  "properties": {
    "question": {
      "type": "string"
    },
    "question_en": {
      "type": "string"
    },
    "question_de": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "answer_en": {
      "type": "string"
    },
    "answer_de": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "General",
        "Shipping",
        "Payment",
        "Returns",
        "Authentication",
        "Warranty",
        "Brand-Specific"
      ]
    },
    "relatedBrand": {
      "type": "string"
    },
    "relatedPage": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "de",
        "en"
      ],
      "default": "de"
    },
    "sortOrder": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "question",
    "answer",
    "category"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "TranslationSettings",
  "type": "object",
  "properties": {
    "defaultProvider": {
      "type": "string",
      "enum": [
        "llm_builtin",
        "deepl",
        "openai",
        "google",
        "microsoft",
        "custom"
      ],
      "default": "llm_builtin"
    },
    "autoTranslateNewContent": {
      "type": "boolean",
      "default": false
    },
    "publishMode": {
      "type": "string",
      "enum": [
        "publish_immediately",
        "draft",
        "needs_review",
        "manual_approval"
      ],
      "default": "manual_approval"
    },
    "browserDetectionMode": {
      "type": "string",
      "enum": [
        "disabled",
        "suggestion_popup",
        "auto_redirect"
      ],
      "default": "suggestion_popup"
    },
    "protectManualEdits": {
      "type": "boolean",
      "default": true
    },
    "defaultTone": {
      "type": "string",
      "enum": [
        "formal",
        "informal"
      ],
      "default": "formal"
    },
    "monthlyCharacterQuota": {
      "type": "number",
      "default": 500000
    },
    "charactersUsedThisMonth": {
      "type": "number",
      "default": 0
    },
    "quotaResetDate": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "defaultProvider"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}
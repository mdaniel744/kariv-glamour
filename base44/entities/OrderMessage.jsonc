{
  "name": "OrderMessage",
  "type": "object",
  "properties": {
    "orderId": {
      "type": "string"
    },
    "buyerId": {
      "type": "string"
    },
    "buyerEmail": {
      "type": "string"
    },
    "buyerName": {
      "type": "string"
    },
    "orderReference": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "sender": {
      "type": "string",
      "enum": [
        "admin",
        "buyer"
      ]
    },
    "isRead": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "orderId",
    "buyerId",
    "body",
    "sender"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyerId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}
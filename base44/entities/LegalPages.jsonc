{
  "name": "LegalPages",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "title_en": {
      "type": "string"
    },
    "title_de": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "content_en": {
      "type": "string"
    },
    "content_de": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "de",
        "en"
      ],
      "default": "de"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoTitle_en": {
      "type": "string"
    },
    "seoTitle_de": {
      "type": "string"
    },
    "seoDescription": {
      "type": "string"
    },
    "seoDescription_en": {
      "type": "string"
    },
    "seoDescription_de": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "slug",
    "content"
  ],
  "rls": {
    "read": true,
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}
{
  "name": "Products",
  "type": "object",
  "properties": {
    "productTitle": {
      "type": "string"
    },
    "productTitle_en": {
      "type": "string"
    },
    "productTitle_de": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "collection": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "referenceNumber": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "New",
        "Unworn",
        "Excellent",
        "Very Good",
        "Good",
        "Vintage"
      ]
    },
    "yearOfProduction": {
      "type": "number"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Men",
        "Women",
        "Unisex"
      ]
    },
    "caseDiameter": {
      "type": "string"
    },
    "caseMaterial": {
      "type": "string"
    },
    "braceletMaterial": {
      "type": "string"
    },
    "dialColor": {
      "type": "string"
    },
    "watchShape": {
      "type": "string",
      "enum": [
        "Round",
        "Rectangular",
        "Square",
        "Oval",
        "Cushion",
        "Tonneau",
        "Octagonal"
      ]
    },
    "movementType": {
      "type": "string"
    },
    "functions": {
      "type": "string"
    },
    "functions_en": {
      "type": "string"
    },
    "functions_de": {
      "type": "string"
    },
    "waterResistance": {
      "type": "string"
    },
    "crystalType": {
      "type": "string"
    },
    "powerReserve": {
      "type": "string"
    },
    "boxIncluded": {
      "type": "boolean"
    },
    "papersIncluded": {
      "type": "boolean"
    },
    "serviceHistory": {
      "type": "string"
    },
    "serviceHistory_en": {
      "type": "string"
    },
    "serviceHistory_de": {
      "type": "string"
    },
    "polishedStatus": {
      "type": "string"
    },
    "polishedStatus_en": {
      "type": "string"
    },
    "polishedStatus_de": {
      "type": "string"
    },
    "originalPartsStatus": {
      "type": "string"
    },
    "originalPartsStatus_en": {
      "type": "string"
    },
    "originalPartsStatus_de": {
      "type": "string"
    },
    "warrantyType": {
      "type": "string"
    },
    "warrantyType_en": {
      "type": "string"
    },
    "warrantyType_de": {
      "type": "string"
    },
    "warrantyDuration": {
      "type": "string"
    },
    "authenticationStatus": {
      "type": "string",
      "enum": [
        "Authenticated",
        "Pending",
        "Not Verified"
      ],
      "default": "Pending",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "super_admin"
              }
            }
          ]
        }
      }
    },
    "authenticityCertificate": {
      "type": "boolean"
    },
    "productDescription": {
      "type": "string"
    },
    "productDescription_en": {
      "type": "string"
    },
    "productDescription_de": {
      "type": "string"
    },
    "shortDescription": {
      "type": "string"
    },
    "shortDescription_en": {
      "type": "string"
    },
    "shortDescription_de": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "salePrice": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "availability": {
      "type": "string",
      "enum": [
        "In Stock",
        "Sold",
        "Reserved",
        "Coming Soon"
      ],
      "default": "In Stock"
    },
    "stockQuantity": {
      "type": "number",
      "default": 1,
      "minimum": 0
    },
    "sku": {
      "type": "string"
    },
    "productImages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featuredImage": {
      "type": "string"
    },
    "shippingInfo": {
      "type": "string"
    },
    "shippingInfo_en": {
      "type": "string"
    },
    "shippingInfo_de": {
      "type": "string"
    },
    "returnEligibility": {
      "type": "boolean",
      "default": true
    },
    "scopeOfDelivery": {
      "type": "string"
    },
    "scopeOfDelivery_en": {
      "type": "string"
    },
    "scopeOfDelivery_de": {
      "type": "string"
    },
    "metaTitle": {
      "type": "string"
    },
    "metaTitle_en": {
      "type": "string"
    },
    "metaTitle_de": {
      "type": "string"
    },
    "metaDescription": {
      "type": "string"
    },
    "metaDescription_en": {
      "type": "string"
    },
    "metaDescription_de": {
      "type": "string"
    },
    "seoKeywords": {
      "type": "string"
    },
    "seoKeywords_en": {
      "type": "string"
    },
    "seoKeywords_de": {
      "type": "string"
    },
    "googleMerchantTitle": {
      "type": "string"
    },
    "googleMerchantTitle_en": {
      "type": "string"
    },
    "googleMerchantTitle_de": {
      "type": "string"
    },
    "googleMerchantDescription": {
      "type": "string"
    },
    "googleMerchantDescription_en": {
      "type": "string"
    },
    "googleMerchantDescription_de": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "isNewArrival": {
      "type": "boolean",
      "default": false
    },
    "isCertifiedPreOwned": {
      "type": "boolean",
      "default": false
    },
    "isVintage": {
      "type": "boolean",
      "default": false
    },
    "isPublished": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "productTitle",
    "brand",
    "price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "isPublished": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dealer"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}

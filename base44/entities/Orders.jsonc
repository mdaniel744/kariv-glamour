{
  "name": "Orders",
  "type": "object",
  "properties": {
    "customerName": {
      "type": "string"
    },
    "customerEmail": {
      "type": "string"
    },
    "buyerId": {
      "type": "string"
    },
    "dealerId": {
      "type": "string"
    },
    "dealerName": {
      "type": "string"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "productTitle": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "brand": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "featuredImage": {
            "type": "string"
          }
        }
      }
    },
    "orderStatus": {
      "type": "string",
      "enum": [
        "Pending",
        "Processing",
        "Shipped",
        "Delivered",
        "Cancelled",
        "Refunded"
      ],
      "default": "Pending"
    },
    "escrowStatus": {
      "type": "string",
      "enum": [
        "pending_review",
        "dealer_accepted",
        "funds_secured",
        "shipped",
        "verified",
        "funds_released",
        "cancelled"
      ],
      "default": "pending_review"
    },
    "paymentStatus": {
      "type": "string",
      "enum": [
        "Pending",
        "Paid",
        "Failed",
        "Refunded"
      ],
      "default": "Pending"
    },
    "paymentMethod": {
      "type": "string",
      "enum": [
        "bank_transfer",
        "credit_card",
        "crypto"
      ]
    },
    "escrowReference": {
      "type": "string"
    },
    "shippingStatus": {
      "type": "string",
      "enum": [
        "Pending",
        "Shipped",
        "In Transit",
        "Delivered"
      ],
      "default": "Pending"
    },
    "totalAmount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "shippingAddress": {
      "type": "string"
    },
    "billingAddress": {
      "type": "string"
    },
    "shippingDetails": {
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        }
      }
    },
    "trackingNumber": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customerName",
    "customerEmail",
    "totalAmount"
  ]
}
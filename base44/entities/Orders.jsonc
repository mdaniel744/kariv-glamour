{
  "name": "Orders",
  "type": "object",
  "properties": {
    "customerName": {
      "type": "string"
    },
    "customerEmail": {
      "type": "string"
    },
    "buyerId": {
      "type": "string"
    },
    "buyerEmail": {
      "type": "string"
    },
    "dealerId": {
      "type": "string"
    },
    "dealerEmail": {
      "type": "string"
    },
    "dealerName": {
      "type": "string"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "productTitle": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "brand": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "featuredImage": {
            "type": "string"
          }
        }
      }
    },
    "orderStatus": {
      "type": "string",
      "enum": [
        "Pending",
        "Processing",
        "Shipped",
        "Delivered",
        "Cancelled",
        "Refunded"
      ],
      "default": "Pending"
    },
    "escrowStatus": {
      "type": "string",
      "enum": [
        "pending_review",
        "dealer_accepted",
        "funds_secured",
        "shipped",
        "verified",
        "funds_released",
        "cancelled"
      ],
      "default": "pending_review"
    },
    "paymentStatus": {
      "type": "string",
      "enum": [
        "Pending",
        "Awaiting Confirmation",
        "Paid",
        "Failed",
        "Refunded"
      ],
      "default": "Pending"
    },
    "paymentMethod": {
      "type": "string",
      "enum": [
        "bank_transfer",
        "crypto"
      ]
    },
    "paymentProvider": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "providerCheckoutId": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "providerPaymentId": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "transactionHash": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "paymentCurrency": {
      "type": "string"
    },
    "paymentNetwork": {
      "type": "string"
    },
    "paymentAmount": {
      "type": "number"
    },
    "paymentProofUrl": {
      "type": "string"
    },
    "reservationExpiresAt": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "idempotencyKey": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "escrowReference": {
      "type": "string"
    },
    "shippingStatus": {
      "type": "string",
      "enum": [
        "Pending",
        "Shipped",
        "In Transit",
        "Delivered"
      ],
      "default": "Pending"
    },
    "totalAmount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "shippingAddress": {
      "type": "string"
    },
    "billingAddress": {
      "type": "string"
    },
    "shippingDetails": {
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        }
      }
    },
    "trackingNumber": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "customerName",
    "customerEmail",
    "totalAmount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyerId": "{{user.id}}"
        },
        {
          "data.dealerId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
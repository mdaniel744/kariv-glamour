{
  "name": "TranslationJob",
  "type": "object",
  "properties": {
    "entityName": {
      "type": "string"
    },
    "contentId": {
      "type": "string"
    },
    "contentTitle": {
      "type": "string"
    },
    "sourceLanguage": {
      "type": "string",
      "enum": [
        "en",
        "de"
      ]
    },
    "targetLanguage": {
      "type": "string",
      "enum": [
        "en",
        "de"
      ]
    },
    "provider": {
      "type": "string",
      "enum": [
        "llm_builtin",
        "deepl",
        "openai",
        "google",
        "microsoft",
        "custom"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "fieldsTranslated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "characterCount": {
      "type": "number",
      "default": 0
    },
    "errorMessage": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "triggerType": {
      "type": "string",
      "enum": [
        "automatic",
        "manual",
        "bulk"
      ],
      "default": "manual"
    }
  },
  "required": [
    "entityName",
    "contentId",
    "sourceLanguage",
    "targetLanguage"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}